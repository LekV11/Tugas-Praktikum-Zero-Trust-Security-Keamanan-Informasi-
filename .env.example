# Zero Trust Sistem Nilai — Environment Configuration
# SALIN FILE INI KE .env DAN ISI DENGAN NILAI YANG SESUAI
# JANGAN COMMIT FILE .env KE REPOSITORY

# ======================
# PORT KONFIGURASI
# ======================
GATEWAY_PORT=3000
SERVICE_NILAI_PORT=3001
SERVICE_TRANSKRIP_PORT=3002

# ======================
# DATABASE
# ======================
# Gunakan path absolut agar semua service menggunakan database yang sama
DB_PATH=./database/zt_sistem_nilai.db

# ======================
# JWT SECRETS
# ======================
# Minimal 32 karakter, gunakan random string yang kuat
JWT_ACCESS_SECRET=ganti_dengan_secret_access_token_yang_kuat_minimal_32_karakter
JWT_REFRESH_SECRET=ganti_dengan_secret_refresh_token_yang_kuat_minimal_32_karakter
JWT_SERVICE_SECRET=ganti_dengan_secret_service_token_yang_kuat_minimal_32_karakter

# JWT Konfigurasi
JWT_ISSUER=zero-trust-sistem-nilai
JWT_AUDIENCE=zt-api

# ======================
# GATEWAY SECRET
# ======================
# Secret untuk komunikasi internal Gateway -> Service
GATEWAY_SECRET=ganti_dengan_gateway_secret_yang_kuat_minimal_32_karakter

# ======================
# SERVICE CLIENT CREDENTIALS
# ======================
# Kredensial untuk Service Nilai agar dapat meminta token service
SERVICE_NILAI_CLIENT_ID=service-nilai
SERVICE_NILAI_CLIENT_SECRET=ganti_dengan_service_nilai_client_secret_yang_kuat

# ======================
# JAM AKSES
# ======================
# Format 24 jam (HH:MM)
ACCESS_TIME_START=07:00
ACCESS_TIME_END=21:00
TIMEZONE=Asia/Jakarta

# ======================
# ENVIRONMENT
# ======================
NODE_ENV=development
