    {
      "name": "02. Nilai — Akses Dosen",
      "item": [
        {
          "name": "TEST 6. Dosen Lihat Nilai Kelas yang Diampu",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "pm.test('Ada data nilai', () => { pm.expect(pm.response.json().data.nilai).to.be.an('array').with.length.above(0); });",
                "// Simpan ID nilai pertama untuk test berikutnya",
                "if (pm.response.json().data.nilai.length > 0) {",
                "  pm.collectionVariables.set('nilai_id_1', pm.response.json().data.nilai[0].id);",
                "}"
              ]
            }
          }],
          "request": {
            "method": "GET",
            "url": "{{gateway_url}}/nilai",
            "header": [
              { "key": "Authorization", "value": "Bearer {{dosen01_token}}" },
              { "key": "X-Device-ID",   "value": "device-dosen-001" }
            ]
          }
        },
        {
          "name": "TEST 8. Dosen Ubah Nilai Sebelum Final (dalam jam akses)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "// Catatan: Test ini hanya berhasil antara 07:00-21:00 WIB",
                "const status = pm.response.status;",
                "if (pm.response.code === 200) {",
                "  pm.test('Nilai berhasil diperbarui', () => pm.response.to.have.status(200));",
                "} else if (pm.response.code === 403) {",
                "  pm.test('Di luar jam akses (diharapkan sesuai konfigurasi jam)', () => { pm.expect(pm.response.json().message).to.include('jam akses'); });",
                "}"
              ]
            }
          }],
          "request": {
            "method": "PUT",
            "url": "{{gateway_url}}/nilai/{{nilai_id_1}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{dosen01_token}}" },
              { "key": "X-Device-ID",   "value": "device-dosen-001" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\"nilai_angka\":88}" }
          }
        },
        {
          "name": "TEST 9. Dosen Tidak Ubah Nilai Yang Sudah Final",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "// ID nilai 4,5 adalah kelas final. Sesuaikan dengan data aktual.",
